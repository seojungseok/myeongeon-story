# ---- Copy this file to ".env.local" and fill in your keys ----

# Public site URL (used for canonical URLs, sitemap, RSS, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Pexels API key — used ONLY by scripts/cache-images.ts at build time.
# Get one free at https://www.pexels.com/api/
PEXELS_API_KEY=

# ---- AI story generator (scripts/generate-story.ts) ----
# Pick ONE provider. Default is gemini (cheapest).
AI_PROVIDER=gemini            # gemini | openai | anthropic
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# YouTube Data API v3 — used by scripts/fetch-youtube.ts (npm run fetch:youtube).
YOUTUBE_API_KEY=

# Optional: Kakao JS key for KakaoTalk share button (client-side).
NEXT_PUBLIC_KAKAO_JS_KEY=

# ---- AdSense (after approval) ----
# When set, ad slots render a real AdSense unit and the loader script is added.
# Leave empty to ship with NO ads and NO ad scripts. e.g. ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=
# Set true ONLY to preview ad-slot positions during development (gray boxes).
# Never shown to visitors when false. Default: false.
NEXT_PUBLIC_AD_PREVIEW=false
